# Deploy settings. Locally, export these before `bun run deploy`. In GitHub Actions they
# live in the "production" environment (see .github/workflows/deploy.yml).
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
# Optional custom domain on a zone in the same account. Leave empty to use workers.dev.
DEPLOY_DOMAIN=

# Worker variables (pass with --var KEY:VALUE or DEPLOY_VARS):
# BETTER_AUTH_URL=https://lockin.<your-subdomain>.workers.dev
# GOOGLE_CLIENT_ID=
# GITHUB_CLIENT_ID=

# Worker secrets (set with `bunx wrangler secret put NAME`):
# BETTER_AUTH_SECRET=   openssl rand -base64 32
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_SECRET=
