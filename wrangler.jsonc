{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "lockin",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "observability": { "enabled": true },
  "secrets": { "required": ["BETTER_AUTH_SECRET", "GOOGLE_CLIENT_SECRET", "GITHUB_CLIENT_SECRET"] },
  // Wrangler reuses the database already bound to this Worker, or creates "lockin-db" on first deploy.
  "d1_databases": [{ "binding": "DB", "database_name": "lockin-db" }],
}
